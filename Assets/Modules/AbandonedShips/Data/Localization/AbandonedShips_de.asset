  m_TableData:
  - m_Id: 1735995392
    m_Localized: "In {zone} treibt ein verlassenes Schiff ({class}). Rechtsklick mit einem Schiff mit zwei Leuten an Bord, um jemanden \xFCberzusetzen."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1765355520
    m_Localized: "{ship} hat keine Crew mehr und treibt. Rechtsklick mit einem Schiff mit zwei Leuten an Bord, um jemanden \xFCberzusetzen."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1769549824
    m_Localized: "{donor} fliegt hin, um jemanden auf {ship} \xFCberzusetzen."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1769549825
    m_Localized: "Kein ausgew\xE4hltes kleines Schiff hat zwei Leute an Bord, um jemanden abzugeben."
    m_Metadata:
      m_Items: []
  - m_Id: 1773744128
    m_Localized: "Niemand ist auf {ship} \xFCbergestiegen."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1773744129
    m_Localized: "Eine Person von {donor} ist auf {ship} \xFCbergestiegen; es fliegt wieder."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1773744130
    m_Localized: '{ship} ist geborgen und fliegt mit der Flotte. Heimathangar: {home}.'
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1773744131
    m_Localized: "{ship} ist geborgen und fliegt mit der Flotte, aber kein Hangar hat Platz daf\xFCr."
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
  - m_Id: 1756125278208
    m_Localized: das verlassene Schiff ({class})
    m_Metadata:
      m_Items:
      - rid: 5599359038138089543
