  m_TableData:
  - m_Id: 1735995392
    m_Localized: An abandoned {class} drifts in {zone}. Right-click it with a ship that has two aboard to put someone on it.
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1765355520
    m_Localized: '{ship} has no crew left and drifts. Right-click it with a ship that has two aboard to put someone on it.'
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1769549824
    m_Localized: '{donor} flies over to put a crew member aboard {ship}.'
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1769549825
    m_Localized: No selected small ship has two aboard to spare one.
    m_Metadata:
      m_Items: []
  - m_Id: 1773744128
    m_Localized: Nobody crossed over to {ship}.
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1773744129
    m_Localized: A crew member of {donor} climbed aboard {ship}; it flies again.
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1773744130
    m_Localized: '{ship} is recovered and flies with the fleet. Home hangar: {home}.'
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1773744131
    m_Localized: '{ship} is recovered and flies with the fleet, but no hangar has room for it.'
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
  - m_Id: 1756125278208
    m_Localized: the abandoned {class}
    m_Metadata:
      m_Items:
      - rid: 5599359038138089544
