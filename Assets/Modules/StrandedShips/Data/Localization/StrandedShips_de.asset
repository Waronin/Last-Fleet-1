  m_TableData:
  - m_Id: 955854848
    m_Localized: Instand setzen
    m_Metadata:
      m_Items: []
  - m_Id: 993603584
    m_Localized: Instandsetzung stoppen
    m_Metadata:
      m_Items: []
  - m_Id: 993603585
    m_Localized: '{class} (gestrandet), etwa {length:0.0} km'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797888
    m_Localized: "H\xFClle: {percent} %"
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797889
    m_Localized: 'Instandsetzung: {metal} Metall, {seconds} s mit angedockter Crew'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797890
    m_Localized: 'Instandsetzung: wartet auf ein angedocktes Schiff mit Crew'
    m_Metadata:
      m_Items: []
  - m_Id: 997797891
    m_Localized: 'Instandsetzung: wartet auf Metall'
    m_Metadata:
      m_Items: []
  - m_Id: 997797892
    m_Localized: "Instandsetzung: l\xE4uft, noch {seconds} s"
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797893
    m_Localized: "{station}: Instandsetzung befohlen. Sie l\xE4uft, solange ein Schiff mit Crew angedockt ist."
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797894
    m_Localized: '{station}: Instandsetzung gestoppt. Der Fortschritt bleibt erhalten.'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797895
    m_Localized: "{ship} schlie\xDFt sich der Flotte an{count:cond:>0?, mit {} \xDCberlebenden an Bord|}. Die Tanks sind leer: Vor dem Sprung muss der Tanker sie f\xFCllen."
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 997797896
    m_Localized: 'Kein Metall mehr: Die Instandsetzung von {station} pausiert.'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
  - m_Id: 16760585138176
    m_Localized: "{station} wurde zerst\xF6rt ({cause}){count:cond:>0?: {} \xDCberlebende sind an Bord gestorben|}."
    m_Metadata:
      m_Items:
      - rid: 5599359018023780424
