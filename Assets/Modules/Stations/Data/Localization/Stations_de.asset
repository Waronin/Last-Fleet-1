  m_TableData:
  - m_Id: 746139648
    m_Localized: nicht angedockt
    m_Metadata:
      m_Items: []
  - m_Id: 775499776
    m_Localized: im Anflug
    m_Metadata:
      m_Items: []
  - m_Id: 779694080
    m_Localized: angedockt
    m_Metadata:
      m_Items: []
  - m_Id: 779694081
    m_Localized: '{ship} fliegt zum Andocken an {station}.'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 783888384
    m_Localized: "{ship} hat an {station} angedockt: Atmosph\xE4re {atmosphere}, Strahlung {radiation}, Zustand {condition}."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 5783475007488
    m_Localized: 'Belegte Andockschleusen: {used}/{total}'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 783888386
    m_Localized: "Kein Schiff zum Andocken verf\xFCgbar."
    m_Metadata:
      m_Items: []
  - m_Id: 783888387
    m_Localized: '{station} hat {ship} gekapert: {count:plural:{} Mensch|{} Menschen} an Bord sind verloren.'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 783888388
    m_Localized: "giftige Atmosph\xE4re"
    m_Metadata:
      m_Items: []
  - m_Id: 783888389
    m_Localized: Strahlung der Station
    m_Metadata:
      m_Items: []
  - m_Id: 783888390
    m_Localized: Angriff der Stationsbesatzung
    m_Metadata:
      m_Items: []
  - m_Id: 783888391
    m_Localized: '{state} an {station}'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 5783466618880
    m_Localized: '{station} hat keine freie Andockschleuse.'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 783888393
    m_Localized: '  {ship}: {state}'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 783888394
    m_Localized: Andocken
    m_Metadata:
      m_Items: []
  - m_Id: 5783424675840
    m_Localized: dockt an
    m_Metadata:
      m_Items: []
  - m_Id: 5783475007489
    m_Localized: Alle Andockschleusen sind belegt.
    m_Metadata:
      m_Items: []
  - m_Id: 15760721784832
    m_Localized: Durchsuchen
    m_Metadata:
      m_Items: []
  - m_Id: 15760730173440
    m_Localized: Docke zuerst ein Schiff an.
    m_Metadata:
      m_Items: []
  - m_Id: 15760730173441
    m_Localized: Hier ist nichts mehr zu finden.
    m_Metadata:
      m_Items: []
  - m_Id: 15760730173442
    m_Localized: "Auf {station} leben Menschen; die Station l\xE4sst sich nicht einfach durchsuchen."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173443
    m_Localized: "Die Atmosph\xE4re auf {station} ist giftig; niemand kann sie durchsuchen."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173444
    m_Localized: "{station} ist vollst\xE4ndig durchsucht."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173445
    m_Localized: '{count:plural:{} Crew durchsucht|{} Crews durchsuchen} {station}.'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173446
    m_Localized: An {station} ist kein Schiff angedockt.
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173447
    m_Localized: "{ship} hat keine freien Pl\xE4tze; auf {station} warten noch \xDCberlebende."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173448
    m_Localized: '{ship} hat auf {station} {reward} gefunden.'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173449
    m_Localized: "{station} ist vollst\xE4ndig durchsucht."
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173450
    m_Localized: 'Durchsucht: bisher {count:plural:{} Fund|{} Funde}'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173451
    m_Localized: "Vollst\xE4ndig durchsucht."
    m_Metadata:
      m_Items: []
  - m_Id: 15760730173452
    m_Localized: '  {ship}: durchsucht ({progress:0%})'
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 15760730173453
    m_Localized: Durchsucht {station}
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
  - m_Id: 19561356800000
    m_Localized: Die Strahlung auf {station} ist zu hoch; niemand kann sie durchsuchen.
    m_Metadata:
      m_Items:
      - rid: 6743102069811707981
