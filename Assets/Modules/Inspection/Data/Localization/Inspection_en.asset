      m_Items: []
  - m_Id: 402245434290180
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 402245434290181
    m_Localized: Welcome, travellers. It has been a long time since anyone came by.
    m_Metadata:
      m_Items: []
  - m_Id: 402245434290182
    m_Localized: Keep your distance and state your business.
    m_Metadata:
      m_Items: []
  - m_Id: 402245434290183
