  - m_Id: 330903556
    m_Localized: "Scan l\xE4uft: {ship}, noch {seconds:0.0} s"
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903557
    m_Localized: 'Scan: {ship} ist unterwegs'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903558
    m_Localized: "Ersch\xF6pft."
    m_Metadata:
      m_Items: []
  - m_Id: 330903559
    m_Localized: Inhalt unbekannt. Ein Scan zeigt Rohstoff, Menge und Gefahren.
    m_Metadata:
      m_Items: []
  - m_Id: 330903560
    m_Localized: 'Rohstoff: {resource}'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903561
    m_Localized: "\xDCbrig: {remaining:0} von {initial:0}"
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903562
    m_Localized: 'Gefahr: {hazard}'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903563
    m_Localized: "Abbaupl\xE4tze: {used}/{total} belegt"
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
