      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903565
    m_Localized: Scannen
    m_Metadata:
      m_Items: []
  - m_Id: 330903566
    m_Localized: Bereits gescannt.
    m_Metadata:
      m_Items: []
  - m_Id: 330903567
    m_Localized: Ein Schiff ist bereits unterwegs.
    m_Metadata:
      m_Items: []
  - m_Id: 330903568
    m_Localized: Scan angefordert.
    m_Metadata:
      m_Items: []
  - m_Id: 330903569
    m_Localized: Abbauen
    m_Metadata:
      m_Items: []
  - m_Id: 330903570
    m_Localized: "Alle Abbaupl\xE4tze sind belegt."
    m_Metadata:
      m_Items: []
  - m_Id: 330903571
    m_Localized: "Kein Sammelschiff verf\xFCgbar."
    m_Metadata:
      m_Items: []
  - m_Id: 330903572
    m_Localized: "{count:plural:{} ausgew\xE4hltes Sammelschiff baut|{} ausgew\xE4hlte Sammelschiffe bauen} ab."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903573
    m_Localized: '{count:plural:{} Sammelschiff|{} Sammelschiffe} zum Abbau gerufen.'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903574
    m_Localized: '{kind}, {distance:0.00} AE vom Stern'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421293
  - m_Id: 330903575
    m_Localized: Treibstoffquelle
    m_Metadata:
      m_Items: []
  - m_Id: 330903576
    m_Localized: Unerforscht. Schicke ein Schiff, um herauszufinden, was dort ist.
    m_Metadata:
      m_Items: []
  - m_Id: 330903577
    m_Localized: 'Vorkommen: {count} ({scanned} gescannt)'
