      - rid: 5599358745442254923
  - m_Id: 418983943
    m_Localized: "{chain}: step {step} \u201C{title}\u201D awaits in {system}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983944
    m_Localized: "{chain}: \u201C{title}\u201D done."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983945
    m_Localized: '{chain} completed.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983946
    m_Localized: '{chain} failed: {reason}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983947
    m_Localized: "{chain}: \u201C{title}\u201D starts over. {reason}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983948
    m_Localized: '{station} answers.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983949
    m_Localized: Explosion in {remaining}!
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983950
    m_Localized: '{station}: power source overloading! Get every ship out of the zone!'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983951
    m_Localized: '{station} exploded. Ships caught in the blast: {count}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983952
    m_Localized: a station explosion
    m_Metadata:
      m_Items: []
  - m_Id: 418983953
    m_Localized: Hail {station}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983954
    m_Localized: "{ship} is flying to the fleet \u2013 protect it!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983955
    m_Localized: '{ship} launches from {station}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983956
    m_Localized: 'Pronin fighters are going for {ship}: {count}!'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983957
    m_Localized: '{ship} has landed aboard {carrier}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 418983958
    m_Localized: '{ship} was lost.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 5115704061952
    m_Localized: 'Zone: {zone}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988700250112
    m_Localized: '{item} is aboard {ship}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833024
    m_Localized: '{item} was lost with {ship}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833025
    m_Localized: '{item} is no longer aboard any ship of the fleet.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833026
    m_Localized: Mine the large rock next to {station}.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833027
    m_Localized: 'Mining for {item}: {percent} %'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833028
    m_Localized: '{item} is aboard {ship}: land it in a hangar or fly it out of the zone.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833029
    m_Localized: '{station} launches {count} guards!'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833030
    m_Localized: '{item} is safe aboard {ship}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833031
    m_Localized: "{item} was lost with {ship}. The rock still holds more \u2013 mine it again."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833032
    m_Localized: The rock is mined out, and {item} is lost.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833033
    m_Localized: "Dock {ship} at {station} \u2013 aboard: {item}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833034
    m_Localized: "{work}: {remaining} left \xB7 docked: {docked} \xB7 highest dose {dose} %"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833035
    m_Localized: "Land {ship} in a hangar of the fleet \u2013 aboard: {item}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833036
    m_Localized: '{ship} handed {item} over to {station}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833037
    m_Localized: '{station} has finished: {item} is ready.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833038
    m_Localized: '{ship} has brought {item} home.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833039
    m_Localized: 'Radiation alarm on {ship} at {station}: undock soon, or the crew starts to die.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 106988712833040
    m_Localized: radiation
    m_Metadata:
      m_Items: []
  - m_Id: 110530097917952
    m_Localized: The crew of {ship} is dead. {station} keeps {item} for the next ship that docks.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 110530127278080
    m_Localized: Nobody is left aboard {ship} to bring {item} home.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 111581844811776
    m_Localized: '{station} has {item} ready: dock a ship with a crew to pick it up.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 139465410031616
    m_Localized: "{work}: {remaining} left \xB7 docked: {docked}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 139465422614528
    m_Localized: "The generator has ignited \u2013 the star of {system} collapses in {remaining}!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 139465422614529
    m_Localized: 'Supernova in {remaining}: get the ships into the hangars and jump out of {system}!'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 139465422614530
    m_Localized: "The fleet got away \u2013 {system} is gone in a supernova."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 139465422614531
    m_Localized: The star of {system} went supernova with the fleet still there.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224789993271296
    m_Localized: People of {station}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020032
    m_Localized: '{amount} {supply}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020033
    m_Localized: an upgrade module
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020034
    m_Localized: We are running short. Bring us {wanted}, and you get {reward} in return.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020035
    m_Localized: "Deal \u2013 we will bring it."
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020036
    m_Localized: Not now.
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020037
    m_Localized: Thank you. Dock with us once you have it, and we will trade.
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020038
    m_Localized: Then good luck out there. The offer stands while you are in the system.
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020039
    m_Localized: We are still waiting for {wanted}. Dock with us once you have it.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020040
    m_Localized: 'Exactly what we needed. As promised: {reward}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020041
    m_Localized: Delivered to {station}; it paid {reward}.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020042
    m_Localized: The deal with {station} lapsed with the jump.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020043
    m_Localized: 'No room for everything {station} paid: {lost} {supply} lost.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
  - m_Id: 1224790031020044
    m_Localized: Requests
    m_Metadata:
      m_Items: []
  - m_Id: 1224790031020045
    m_Localized: '{station}: bring {wanted} (in stock: {stock}) for {reward}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254923
