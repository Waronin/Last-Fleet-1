  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Meltdown_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 6566d6d7410996c46a34f719ba3d9f33, type: 2}
  m_Metadata:
    m_Items:
    - rid: 5599358745442254924
  m_TableData:
  - m_Id: 326709248
    m_Localized: Meltdown
    m_Metadata:
      m_Items: []
  - m_Id: 339292160
    m_Localized: Die Ascalon-Plattform
    m_Metadata:
      m_Items: []
  - m_Id: 339292161
    m_Localized: Durchsucht die verlassene Ascalon-Plattform.
    m_Metadata:
      m_Items: []
  - m_Id: 339292162
    m_Localized: Die Wissenschaftlerin
    m_Metadata:
      m_Items: []
  - m_Id: 339292163
    m_Localized: Funkt die Forschungsstation Meridian an und eskortiert ihr Shuttle sicher in einen Hangar der Flotte.
    m_Metadata:
      m_Items: []
  - m_Id: 339292164
    m_Localized: Der heilige Fels
    m_Metadata:
      m_Items: []
  - m_Id: 339292165
    m_Localized: "Baue am gro\xDFen Felsen neben der Kethran Vigil Solarit ab und bringe den Harvester danach in Sicherheit: in einen Hangar oder aus der Zone. Die J\xE4ger der Station verteidigen den Felsen."
    m_Metadata:
      m_Items: []
  - m_Id: 339292166
    m_Localized: Aufbereitung
    m_Metadata:
      m_Items: []
  - m_Id: 339292167
    m_Localized: "Docke das Schiff mit dem Solarit an der verlassenen Tamsin Forge an. Dort lebt niemand: Der Ofen l\xE4uft nur, solange ein Schiff mit Crew angedockt ist, insgesamt etwa 5 Minuten. Die Station ist radioaktiv: Wechselt euch beim Andocken ab. Lande danach das raffinierte Solarit in einem Hangar."
    m_Metadata:
      m_Items: []
  - m_Id: 339292168
    m_Localized: "Z\xFCndung"
    m_Metadata:
      m_Items: []
  - m_Id: 339292169
    m_Localized: Bringt das aufbereitete Mineral zum Kraftwerk und haltet es 10 Minuten. Danach springt die Flotte.
    m_Metadata:
      m_Items: []
  - m_Id: 339292170
    m_Localized: Suchtrupp auf {station}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 339292171
    m_Localized: "Alarm! Beim \xD6ffnen des Reaktorraums ist eine experimentelle Energiequelle angesprungen \u2013 sie geht durch! Noch etwa {seconds} Sekunden. Die Logs nennen den Hersteller: {manufacturer}. Ihr Prototyp stammt aus einer Forschungsstation ganz in der N\xE4he. Wir verschwinden \u2013 zieht alle Schiffe aus der Zone ab!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 339292172
    m_Localized: "Hier {scientist} auf {station}. Die Explosion auf Ascalon war mein Reaktor \u2013 ein kleiner. Ich habe die Pl\xE4ne f\xFCr eine weit gr\xF6\xDFere Version, und die Pronin wissen das. Nehmt mich mit. Mein Shuttle startet, sobald ihr es deckt."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 339292173
    m_Localized: Wir decken euch. Startet.
    m_Metadata:
      m_Items: []
  - m_Id: 339292174
    m_Localized: Noch nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 339292175
    m_Localized: Wir starten. Bringt mich heil zu eurer Flotte.
    m_Metadata:
      m_Items: []
  - m_Id: 339292176
    m_Localized: "Wartet nicht zu lange. Die Pronin h\xF6ren mit."
    m_Metadata:
      m_Items: []
  - m_Id: 339292177
    m_Localized: "Danke. Jetzt die Wahrheit: In gro\xDFem Ma\xDFstab kann mein Generator eine Supernova ausl\xF6sen. Eine Waffe gegen die Pronin. Aber er braucht ein aufbereitetes Mineral \u2013 und ich wei\xDF, wo der Fels liegt."
    m_Metadata:
      m_Items: []
  - m_Id: 106988297596928
    m_Localized: Solarit
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985536
    m_Localized: Raffiniertes Solarit
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985537
    m_Localized: "H\xFCter der {station}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 106988305985538
    m_Localized: "Hier spricht die {station}. Der gro\xDFe Felsen an unserer Seite ist uns heilig. Wer Hand an ihn legt, bekommt es mit unseren W\xE4chtern zu tun."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 106988305985539
    m_Localized: Verstanden.
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985540
    m_Localized: Wir brauchen, was in ihm steckt.
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985541
    m_Localized: Dann zieht in Frieden.
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985542
    m_Localized: "Dann m\xFCsst ihr es uns nehmen. Freiwillig geben wir es nicht her."
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985543
    m_Localized: "Ihr vergreift euch am heiligen Felsen! W\xE4chter \u2013 vertreibt sie!"
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985544
    m_Localized: "Das ist es \u2013 Solarit. Roh n\xFCtzt es dem Generator nichts. Es muss raffiniert werden, und ich kenne eine Raffinerie, deren Ofen noch arbeitet. Ihre Crew ist l\xE4ngst fort \u2013 die Strahlung hat sie vertrieben."
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985545
    m_Localized: "Automatische Raffinerie {station}. Personal an Bord: keines. Reaktorabschirmung: ausgefallen \u2013 t\xF6dliche Strahlung bei l\xE4ngerem Aufenthalt. Ofen bereit f\xFCr Solarit, etwa {minutes} Minuten. Betrieb nur mit Crew vor Ort: Haltet ein Schiff angedockt."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 106988305985546
    m_Localized: "Das Solarit ist im Ofen. Hier ist sonst niemand \u2013 wir halten die Anlage selbst am Laufen. Die Dosimeter ticken schon."
    m_Metadata:
      m_Items: []
  - m_Id: 106988305985547
    m_Localized: "Der Ofen ist fertig. Das raffinierte Solarit ist an Bord \u2013 wir kommen heim."
    m_Metadata:
      m_Items: []
  - m_Id: 126382587326464
    m_Localized: Steuersystem der {station}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
  - m_Id: 126382620880896
    m_Localized: Crew von {ship}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254924
