  m_TableData:
  - m_Id: 406401024
    m_Localized: "Quest: {chain} \u2013 Schritt {step}/{count}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983936
    m_Localized: Quests
    m_Metadata:
      m_Items: []
  - m_Id: 418983937
    m_Localized: "{chain} \u2013 Schritt {step}/{count}: {title}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983938
    m_Localized: Im System {system}
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983939
    m_Localized: In diesem System
    m_Metadata:
      m_Items: []
  - m_Id: 418983940
    m_Localized: (noch nicht spielbar)
    m_Metadata:
      m_Items: []
  - m_Id: 418983941
    m_Localized: '{chain}: abgeschlossen'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983942
    m_Localized: '{chain}: gescheitert'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983943
    m_Localized: "{chain}: Schritt {step} \u201E{title}\u201C wartet in {system}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983944
    m_Localized: "{chain}: \u201E{title}\u201C geschafft."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983945
    m_Localized: '{chain} abgeschlossen.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983946
    m_Localized: '{chain} gescheitert: {reason}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983947
    m_Localized: "{chain}: \u201E{title}\u201C beginnt von vorn. {reason}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983948
    m_Localized: '{station} antwortet.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983949
    m_Localized: Explosion in {remaining}!
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983950
    m_Localized: "{station}: Energiequelle \xFCberlastet! Alle Schiffe raus aus der Zone!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983951
    m_Localized: '{station} ist explodiert. Von der Druckwelle erfasste Schiffe: {count}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983952
    m_Localized: eine Stationsexplosion
    m_Metadata:
      m_Items: []
  - m_Id: 418983953
    m_Localized: '{station} anfunken'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983954
    m_Localized: "{ship} fliegt zur Flotte \u2013 besch\xFCtzt es!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983955
    m_Localized: '{ship} startet von {station}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983956
    m_Localized: "Pronin-J\xE4ger greifen {ship} an: {count}!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983957
    m_Localized: '{ship} ist an Bord von {carrier} gelandet.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 418983958
    m_Localized: '{ship} ist verloren.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 5115704061952
    m_Localized: 'Zone: {zone}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988700250112
    m_Localized: '{item} ist an Bord von {ship}.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833024
    m_Localized: '{item} ging mit {ship} verloren.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833025
    m_Localized: '{item} ist auf keinem Schiff der Flotte mehr.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833026
    m_Localized: "Baue den gro\xDFen Felsen neben {station} ab."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833027
    m_Localized: 'Abbau von {item}: {percent} %'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833028
    m_Localized: '{item} ist an Bord von {ship}: in einem Hangar landen oder aus der Zone fliegen.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833029
    m_Localized: "{station} startet {count} W\xE4chter!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833030
    m_Localized: '{item} ist an Bord von {ship} in Sicherheit.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833031
    m_Localized: "{item} ging mit {ship} verloren. Der Felsen gibt noch mehr her \u2013 baue ihn erneut ab."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833032
    m_Localized: Der Felsen ist abgebaut, und {item} ist verloren.
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833033
    m_Localized: "Docke {ship} an {station} an \u2013 an Bord: {item}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833034
    m_Localized: "{work}: noch {remaining} \xB7 angedockt: {docked} \xB7 h\xF6chste Dosis {dose} %"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833035
    m_Localized: "Lande {ship} in einem Hangar der Flotte \u2013 an Bord: {item}."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833036
    m_Localized: "{ship} hat {item} an {station} \xFCbergeben."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833037
    m_Localized: '{station} ist fertig: {item} ist bereit.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833038
    m_Localized: '{ship} hat {item} heimgebracht.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833039
    m_Localized: 'Strahlungsalarm auf {ship} an {station}: bald abdocken, sonst stirbt die Crew.'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 106988712833040
    m_Localized: Strahlung
    m_Metadata:
      m_Items: []
  - m_Id: 110530097917952
    m_Localized: "Die Crew von {ship} ist tot. {station} verwahrt {item} f\xFCr das n\xE4chste Schiff, das andockt."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 110530127278080
    m_Localized: "An Bord von {ship} lebt niemand mehr, der {item} heimbringen k\xF6nnte."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 111581844811776
    m_Localized: "{station} h\xE4lt {item} bereit: Docke ein Schiff mit Crew an, um es abzuholen."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 139465410031616
    m_Localized: "{work}: noch {remaining} \xB7 angedockt: {docked}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 139465422614528
    m_Localized: "Der Generator ist gez\xFCndet \u2013 der Stern von {system} kollabiert in {remaining}!"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 139465422614529
    m_Localized: 'Supernova in {remaining}: Schiffe in die Hangars und raus aus {system}!'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 139465422614530
    m_Localized: "Die Flotte ist entkommen \u2013 {system} vergeht in einer Supernova."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
  - m_Id: 139465422614531
    m_Localized: "Der Stern von {system} wurde zur Supernova, w\xE4hrend die Flotte noch dort war."
    m_Metadata:
      m_Items:
      - rid: 5599358745442254921
