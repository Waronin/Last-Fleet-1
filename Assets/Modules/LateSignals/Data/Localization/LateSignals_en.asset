  m_TableData:
  - m_Id: 842608640
    m_Localized: 'Distress call received: a stranded ship at {zone} is calling for help.'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780431
  - m_Id: 871968768
    m_Localized: 'New signal: {zone} has broken its radio silence.'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780431
  - m_Id: 871968769
    m_Localized: New signal picked up from {zone}.
    m_Metadata:
      m_Items:
      - rid: 5599359018023780431
  - m_Id: 12104316301312
    m_Localized: 'New signal: a wreck field has drifted into sensor range at {zone}.'
    m_Metadata:
      m_Items:
      - rid: 5599359018023780431
  - m_Id: 19545611382784
    m_Localized: "Distress call \u2013 {zone}"
    m_Metadata:
      m_Items:
      - rid: 5599359018023780431
  - m_Id: 19545649131520
    m_Localized: This is the crew of a stranded ship. Our drive is dead and the air is running out. If anyone can hear us, please, send help!
    m_Metadata:
      m_Items: []
  - m_Id: 19545653325824
    m_Localized: Send a shuttle
    m_Metadata:
      m_Items: []
  - m_Id: 19545653325825
    m_Localized: Ignore
    m_Metadata:
      m_Items: []
