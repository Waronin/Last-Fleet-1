  - m_Id: 850997248
    m_Localized: Sprung bereit
    m_Metadata:
      m_Items: []
  - m_Id: 855191552
    m_Localized: Sprung nach {system} in {remaining}
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191553
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 855191554
    m_Localized: Springen (Enter)
    m_Metadata:
      m_Items: []
  - m_Id: 855191555
    m_Localized: Sprung nach {system} ({distance} Lj)?
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191556
    m_Localized: "{ship}: -{cost} Treibstoff, {left} \xFCbrig (noch {jumps:plural:1 weiter Sprung|{} weite Spr\xFCnge})"
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191557
    m_Localized: "{ship} bleibt zur\xFCck: braucht {cost} Treibstoff, hat {left}."
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191558
    m_Localized: '{count:plural:1 kleines Schiff ist|{} kleine Schiffe sind} nicht im Hangar und gehen verloren:'
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191559
    m_Localized: Alle kleinen Schiffe sind im Hangar.
    m_Metadata:
      m_Items: []
  - m_Id: 855191560
    m_Localized: "Kein Kapitalschiff hat genug Treibstoff f\xFCr diesen Sprung."
    m_Metadata:
      m_Items: []
  - m_Id: 855191561
    m_Localized: "Der Sprungantrieb k\xFChlt noch ab ({remaining})."
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191562
    m_Localized: "{system} liegt au\xDFerhalb der Sprungreichweite."
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191563
    m_Localized: "Sprungantrieb l\xE4dt: Sprung nach {system} in {remaining}. Kleine Schiffe zur\xFCckrufen!"
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191564
    m_Localized: Sprung abgebrochen.
    m_Metadata:
      m_Items: []
  - m_Id: 855191565
    m_Localized: "Der Sprungantrieb l\xE4dt bereits."
    m_Metadata:
      m_Items: []
  - m_Id: 855191566
    m_Localized: Die Flotte ist mit {count:plural:1 Kapitalschiff|{} Kapitalschiffen} nach {system} gesprungen.
    m_Metadata:
      m_Items:
      - rid: 5599358707687751756
  - m_Id: 855191567
    m_Localized: Kein Kapitalschiff hat genug Treibstoff; der Sprung findet nicht statt.
    m_Metadata:
      m_Items: []
  - m_Id: 855191568
    m_Localized: "Zur\xFCcklassen beim Sprung"
    m_Metadata:
      m_Items: []
