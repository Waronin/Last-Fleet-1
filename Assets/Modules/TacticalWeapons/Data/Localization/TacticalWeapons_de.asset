  m_TableData:
  - m_Id: 1060712448
    m_Localized: EMP-Rakete abfeuern
    m_Metadata:
      m_Items: []
  - m_Id: 1085878272
    m_Localized: EMP-Rakete bauen
    m_Metadata:
      m_Items: []
  - m_Id: 1090072576
    m_Localized: Keine EMP-Rakete an Bord.
    m_Metadata:
      m_Items: []
  - m_Id: 1090072577
    m_Localized: "Das Schiff ist bet\xE4ubt."
    m_Metadata:
      m_Items: []
  - m_Id: 1090072578
    m_Localized: Das Kriegsschiff ist nicht in der angezeigten Zone.
    m_Metadata:
      m_Items: []
  - m_Id: 1090072579
    m_Localized: Das Magazin ist voll.
    m_Metadata:
      m_Items: []
  - m_Id: 1090072580
    m_Localized: Es wird schon eine Rakete gebaut.
    m_Metadata:
      m_Items: []
  - m_Id: 1090072581
    m_Localized: Braucht {metal:0} Metall und {fuel:0} Treibstoff im Lager.
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1090072582
    m_Localized: 'EMP-Raketen: {count}/{capacity}'
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1090072583
    m_Localized: 'Baut EMP-Rakete: noch {seconds:0} s'
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1098461184
    m_Localized: "Bet\xE4ubt: noch {seconds:0.0} s"
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1098461185
    m_Localized: 'EMP zielen: Linksklick feuert, Rechtsklick oder M bricht ab.'
    m_Metadata:
      m_Items: []
  - m_Id: 1098461186
    m_Localized: EMP-Start abgebrochen.
    m_Metadata:
      m_Items: []
  - m_Id: 1098461187
    m_Localized: '{ship} startet eine EMP-Rakete.'
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1098461188
    m_Localized: "EMP-Rakete in Bau f\xFCr {metal:0} Metall und {fuel:0} Treibstoff."
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1098461189
    m_Localized: '{ship}: EMP-Rakete fertig ({count}/{capacity}).'
    m_Metadata:
      m_Items:
      - rid: 5599358864159670346
  - m_Id: 1098461190
    m_Localized: "EMP: {enemies:plural:{} feindliches Schiff|{} feindliche Schiffe} und {own:plural:{} eigenes Schiff|{} eigene Schiffe} bet\xE4ubt."
    m_Metadata:
      m_Items:
