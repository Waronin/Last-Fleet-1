  - m_Id: 1425616896
    m_Localized: Reparatur abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 1425616897
    m_Localized: "Kein ausgew\xE4hltes Schiff braucht eine Reparatur."
    m_Metadata:
      m_Items: []
  - m_Id: 1429811200
    m_Localized: Kleine Schiffe werden nur im Hangar repariert.
    m_Metadata:
      m_Items: []
  - m_Id: 1429811201
    m_Localized: "Ist schon als N\xE4chstes dran."
    m_Metadata:
      m_Items: []
  - m_Id: 1429811202
    m_Localized: '{count:plural:{} Schiff|{} Schiffe} zur Reparatur eingereiht.'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1429811203
    m_Localized: "{count:plural:{} Schiff wird|{} Schiffe werden} als N\xE4chstes repariert."
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1429811204
    m_Localized: '{count:plural:{} Reparatur|{} Reparaturen} abgebrochen.'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1429811205
    m_Localized: "Reparatur: l\xE4uft, +{rate:0} H\xFClle/s"
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1429811206
    m_Localized: 'Reparatur: wartet, Platz {position} in der Werft von {yard}'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1434005504
    m_Localized: 'Reparatur: wartet auf Metall'
    m_Metadata:
      m_Items: []
  - m_Id: 1434005505
    m_Localized: 'Werft: repariert {ship}{waiting:cond:>0?, {} wartend|}'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1434005506
    m_Localized: '{ship} ist repariert.'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1434005507
    m_Localized: 'Reparatur von {ship} abgebrochen: Das Schiff hat den Hangar verlassen.'
    m_Metadata:
      m_Items:
      - rid: 5599358846693802058
  - m_Id: 1434005508
    m_Localized: 'Kein Metall mehr: Die Reparaturen pausieren.'
