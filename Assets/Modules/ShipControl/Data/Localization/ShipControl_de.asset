  - m_Id: 339292161
    m_Localized: "W\xE4hle Schiffe aus, um eine Staffel zu bilden."
    m_Metadata:
      m_Items: []
  - m_Id: 343486464
    m_Localized: Eine Staffel kann nur Schiffe einer Klasse enthalten.
