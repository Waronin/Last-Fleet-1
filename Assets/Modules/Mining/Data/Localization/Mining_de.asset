  - m_Id: 4551304503963652
    m_Localized: Zuerst betanken
    m_Metadata:
      m_Items: []
  - m_Id: 4551304503963651
    m_Localized: '{ship}: Betankung abgebrochen, {tanker} ist nicht mehr in derselben Zone.'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 4547081984880642
    m_Localized: '{target} ist vollgetankt.'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 4551304503963650
    m_Localized: 'Betankung wartet: {tanker} hat keinen Treibstoff im Lager'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 4547081984880644
    m_Localized: '{tanker}: Kein Treibstoff mehr im Lager. Die Betankung wartet, bis wieder Treibstoff da ist.'
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 4547081984880645
    m_Localized: Betanken
    m_Metadata:
      m_Items: []
