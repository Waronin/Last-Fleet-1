      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320647
    m_Localized: "{ship}: In {zone} ist kein freies Vorkommen mehr \xFCbrig."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320648
    m_Localized: "{ship}: Kein Lager mit Platz f\xFCr {resource}. Fracht auswerfen, um weiter abzubauen."
