  - m_Id: 318320640
    m_Localized: Anflug auf Vorkommen
    m_Metadata:
      m_Items: []
  - m_Id: 318320641
    m_Localized: "Abbau l\xE4uft"
    m_Metadata:
      m_Items: []
  - m_Id: 318320642
    m_Localized: Abliefern
    m_Metadata:
      m_Items: []
  - m_Id: 318320643
    m_Localized: "Tr\xFCmmer eines zerbrechenden Asteroiden"
    m_Metadata:
      m_Items: []
  - m_Id: 318320644
    m_Localized: eine Gasexplosion
    m_Metadata:
      m_Items: []
  - m_Id: 318320645
    m_Localized: "In {zone} ist ein Asteroid zerbrochen; {count:plural:{} Schiff|{} Schiffe} von Tr\xFCmmern getroffen."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320646
    m_Localized: "In {zone} sind Gaseinschl\xFCsse explodiert; {count:plural:{} Schiff|{} Schiffe} getroffen."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320647
    m_Localized: "{ship}: In {zone} ist kein freies Vorkommen mehr \xFCbrig."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320648
    m_Localized: "{ship}: Kein Lager mit Platz f\xFCr {resource}. Fracht auswerfen, um weiter abzubauen."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 326709248
    m_Localized: "{storage}: In der Flotte ist kein Platz mehr f\xFCr {resource}. Fracht auswerfen, um weiter abzubauen."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 326709249
    m_Localized: "{ship} hat den Abbau beendet: zu wenig Treibstoff f\xFCr den Sprung ({needed:0.0} n\xF6tig, {left:0.0} \xFCbrig)."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 378058334351360
    m_Localized: Strahlung
