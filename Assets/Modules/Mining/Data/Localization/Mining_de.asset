    m_Metadata:
      m_Items: []
  - m_Id: 318320645
    m_Localized: "In {zone} ist ein Asteroid zerbrochen; {count:plural:{} Schiff|{} Schiffe} von Tr\xFCmmern getroffen."
    m_Metadata:
      m_Items:
      - rid: 6743102046643421294
  - m_Id: 318320646
    m_Localized: "In {zone} sind Gaseinschl\xFCsse explodiert; {count:plural:{} Schiff|{} Schiffe} getroffen."
