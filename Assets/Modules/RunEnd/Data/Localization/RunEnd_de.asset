  m_TableData:
  - m_Id: 1022963712
    m_Localized: Die Flotte ist entkommen
    m_Metadata:
      m_Items: []
  - m_Id: 1060712448
    m_Localized: Die Flotte ist verloren
    m_Metadata:
      m_Items: []
  - m_Id: 1064906752
    m_Localized: 'Gerettete Menschen: {people}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 1064906753
    m_Localized: 'Schiffe in der Flotte: {ships}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 1073295360
    m_Localized: 'Zeit: {time}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 1073295361
    m_Localized: Neuer Lauf
    m_Metadata:
      m_Items: []
  - m_Id: 4561374662963200
    m_Localized: "Die Pronin haben unsere Spur verloren. Wer \xFCberlebt hat, verdankt es dir."
    m_Metadata:
      m_Items: []
  - m_Id: 4561374688129024
    m_Localized: Das letzte Licht der Menschheit ist erloschen. Doch was du gerettet hast, bleibt in Erinnerung.
    m_Metadata:
      m_Items: []
  - m_Id: 4561374688129025
    m_Localized: "Das letzte Kapitalschiff der Flotte wurde zerst\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 4561374688129026
    m_Localized: 'Gerettete Menschen: {count}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 4561374692323328
    m_Localized: "\xDCberlebende am Ende: {count}"
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 4561374692323329
    m_Localized: 'Gewonnene kleine Schiffe: {count}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 4561374692323330
    m_Localized: 'Gewonnene Kapitalschiffe: {count}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 4561374692323331
    m_Localized: 'Gefundene Hinweise: {count}'
    m_Metadata:
      m_Items:
      - rid: 5599358745442254937
  - m_Id: 4561374692323332
    m_Localized: Sieg
    m_Metadata:
      m_Items: []
  - m_Id: 4561374692323333
    m_Localized: 'Verlorene Menschen: {count}'
    m_Metadata:
      m_Items:
